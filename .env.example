# Tunisian Automotive Sources Portal â€” environment template
# Copy to `.env.local` for local development. Never commit real secrets.
# Full reference: docs/env-variables.md
# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•

# â”€â”€ Database (REQUIRED) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Neon *pooled* connection string (host contains "-pooler").
# Keep sslmode=require. pgbouncer=true is required for the pooled endpoint.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"

# Neon *direct* (unpooled) connection used by Prisma Migrate and the importer.
# Remove "-pooler" from the host. For local Postgres, use the same value as
# DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# Optional: Prisma Accelerate. When set, it takes precedence over DATABASE_URL.
# PRISMA_ACCELERATE_URL="prisma://accelerate.prisma-data.net/?api_key=REPLACE_ME"

# â”€â”€ Public site identity â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
NEXT_PUBLIC_SITE_URL="https://your-domain.vercel.app"
NEXT_PUBLIC_SITE_NAME="Ø¨ÙˆØ§Ø¨Ø© Ù…ØµØ§Ø¯Ø± Ø§Ù„Ø³ÙŠØ§Ø±Ø§Øª Ø§Ù„ØªÙˆÙ†Ø³ÙŠØ©"

# Optional public contact details shown in the footer / About page.
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_WHATSAPP=""

# â”€â”€ Admin review â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Required in production for /admin/submissions and /api/admin/*.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN="replace-with-a-long-random-token"

# Protects the Vercel Cron endpoint (/api/cron/check-links).
# Vercel sends it automatically as: Authorization: Bearer <CRON_SECRET>
CRON_SECRET="replace-with-another-long-random-token"

# â”€â”€ Email notifications (optional) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# The portal works without SMTP: notifications are queued in PostgreSQL.
# Set these only when you connect a real mail sender.
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
ADMIN_EMAIL=""

# Optional HTTP webhook that drains the notification outbox.
# NOTIFY_WEBHOOK_URL=""

# â”€â”€ Error tracking (optional) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
SENTRY_DSN=""
# NEXT_PUBLIC_SENTRY_DSN=""
# Optional source-map upload (Sentry build step).
# SENTRY_ORG=""
# SENTRY_PROJECT=""
# SENTRY_AUTH_TOKEN=""
# SENTRY_TRACES_SAMPLE_RATE="0.1"

# â”€â”€ reCAPTCHA v3 (optional) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
# RECAPTCHA_SECRET_KEY=""

# â”€â”€ Seeding / maintenance â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Runtime seeding is disabled in production by default. Keep it false on
# Vercel and seed during the deployment step instead.
ALLOW_RUNTIME_SEEDING="false"
# Only used by `npm run db:migrate:sqlite` (never by the running app).
SQLITE_DATABASE_PATH="./data/car-sources.db"
# Optional seed file overrides.
# SEED_DATA_PATH="./data/sources.json"
# OBD_DATA_PATH="./data/obd-codes.json"
# MIGRATION_REPORT_DIR="./migration-reports"

# â”€â”€ Debugging â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Set to 1 to print every SQL query in development.
# PRISMA_LOG="0"
